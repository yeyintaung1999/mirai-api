*.key
*.p12
*.pfx
token.sh

# Generated Lambda layers
/infra/layers/

# Logs and diagnostic reports
*.log
npm-debug.log*
/logs/
report.*.json

# Test coverage and caches
/coverage/
/.nyc_output/
/.cache/

# Local database backups
/backup.sql

# Local tooling and editor settings
/local-setup/
/.claude/
/.idea/
/.vscode/
*.swp
*.swo
*~

# Operating system files
.DS_Store
._*
Thumbs.db
Desktop.ini
